# Скопіюйте у .env і за потреби поправте:  cp .env.example .env
#
# .env у git НЕ потрапляє — там справжні паролі й секрети.
# .env.example потрапляє: за ним колега відтворює налаштування.

DATABASE_URL="postgresql://demo:demo@localhost:5432/notes?schema=public"

# Секрет, яким підписуються токени. Локально підійде будь-який рядок,
# у проді — довгий випадковий і заданий змінною середовища.
# Потрапив у публічний коміт — вважайте, що витік: міняйте секрет,
# а не видаляйте коміт.
JWT_SECRET="dev-secret-change-me"

# Строк життя токена. Коротший — вужче вікно, якщо токен витече.
JWT_EXPIRES_IN="1h"
