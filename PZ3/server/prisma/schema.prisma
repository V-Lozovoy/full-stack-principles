// Схема — одне джерело правди: з неї народжуються і таблиці в базі,
// і TypeScript-типи в коді. Змінили схему → міграція → новий клієнт.

generator client {
  provider = "prisma-client"
  // Генерований клієнт лежить усередині src, щоб tsc його бачив.
  // У git не комітиться — відновлюється командою npx prisma generate.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url тут більше немає: з Prisma 7 він задається у prisma.config.ts
}

// Дано як стартова точка: одна сутність, самі скалярні поля.
// Замініть на свій домен — назву моделі, поля, @@map.

model User {
  id Int       @id @default(autoincrement())
  email String @unique
  notes Note[]

  @@map("users")
}

model Note {
  id Int         @id @default(autoincrement())
  title String   @db.VarChar(100)
  text String?
  lat Float
  lng Float
  visited Boolean       @default(false)
  createdAt DateTime @default(now())
  
  authorId Int
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  tags Tag[]

  @@index([authorId])
  @@map("notes")
}

model Tag {
  id Int        @id @default(autoincrement())
  name String   @unique
  notes Note[]
}

// TODO(1) [Пз3 · Л3, «schema.prisma: звʼязки 1 : N і N : M»]: друга сутність і звʼязок між ними.
//
// Результат: у схемі 2+ моделі, між ними справжній звʼязок, а в базі —
// зовнішній ключ, який не дасть створити запис із неіснуючим власником.
//
//   1 : N — «у нотатки один автор, у автора багато нотаток»:
//       у Note:  authorId Int
//                author   User @relation(fields: [authorId], references: [id],
//                                        onDelete: Cascade)
//       у User:  notes    Note[]
//       Звʼязок пишеться з ОБОХ боків — Prisma звіряє їх між собою.
//
//   N : M — «у нотатки багато тегів, у тега багато нотаток»:
//       у Note:  tags  Tag[]
//       у Tag:   notes Note[]
//       Таблицю звʼязку Prisma створить сама — писати її руками не треба.
//
//   @@index([authorId]) — під найчастіший фільтр. Без індексу пошук
//   «нотатки цього автора» читає всю таблицю; з ним — стрибає одразу.
//
// Досить одного звʼязку (1 : N або N : M) — обидва беруть, хто хоче.
// Модель User стане в пригоді вже в Пз4: там до неї приїдуть password і role.
//
// Як видно, що не зроблено: у migration.sql немає жодного FOREIGN KEY.
