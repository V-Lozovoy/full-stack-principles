# Опис вашої сутності для контрактної перевірки.
# Єдиний файл, який треба відредагувати під свій домен.

# Шлях ресурсу після /api — множина, іменником.
RES=notes

# Валідне тіло для POST: усі обовʼязкові поля, справжні значення.
GOOD='{"title":"Кавʼярня на Яворницького","lat":48.4647,"lng":35.0462,"tags":["кава"]}'

# Тіло для PATCH: одне-два поля, які можна змінити частково.
PATCH='{"visited":true}'

# Тіло, яке МАЄ бути відхилене з 400, і поле, назву якого чекаємо в details.
BAD='{"title":"","lat":999,"lng":35.0462}'
BAD_FIELD=title

# ── З Пз4: маршрути закриті токеном, тому перевірка спершу входить ──
# Порожній AUTH_LOGIN вимикає вхід — так було в Пз2 і Пз3.
AUTH_REGISTER=/auth/register
AUTH_LOGIN=/auth/login
AUTH_USER='{"email":"checker@example.com","password":"checker-secret-123"}'
